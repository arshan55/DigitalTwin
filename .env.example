# ==========================================
# India Air Quality & Climate Digital Twin
# API Credentials & Configuration
# ==========================================

# 1. Copernicus Data Space Ecosystem (CDSE) / Sentinel-5P
# Sign up at: https://dataspace.copernicus.eu/
CDSE_USERNAME=your_cdse_username
CDSE_PASSWORD=your_cdse_password
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 2. Copernicus Climate Data Store (CDS) / ERA5 & ERA5-Land
# Sign up at: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_cds_api_key

# 3. NASA Earthdata Login / MODIS AOD & MERRA-2
# Sign up at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# 4. NASA FIRMS / VIIRS Active Fire Data
# Request free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_firms_map_key

# 5. OpenAQ API (Optional ground truth fallback)
# Sign up at: https://openaq.org/
OPENAQ_API_KEY=

# 6. Pipeline Settings
DATA_DIR=./data
USE_SAMPLE_DATA=true
LOG_LEVEL=INFO
